[Unit]
Description=Boiler Display OCR MQTT Service (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust User and the deploy path (repo root on the Pi) to match your setup.
User=admin
WorkingDirectory=/home/admin/boilerocr
ExecStart=/home/admin/boilerocr/.venv/bin/python -m boiler_ocr.mqtt_oneshot
StandardOutput=journal
StandardError=journal

# Resource limits for faster execution
Nice=0
IOSchedulingClass=realtime
IOSchedulingPriority=0
