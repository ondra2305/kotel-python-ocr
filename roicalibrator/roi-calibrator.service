[Unit]
Description=Boiler ROI Calibrator Web Interface
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/roicalibrator
ExecStart=/usr/bin/python3 /home/pi/roicalibrator/roi_calibrator.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
